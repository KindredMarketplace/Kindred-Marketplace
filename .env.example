# =============================================================================
# Kindred Marketplace — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local
# =============================================================================

# ---- Supabase ---------------------------------------------------------------
# Get these from https://supabase.com/dashboard/project/<your-ref>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---- Stripe -----------------------------------------------------------------
# Get from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for development
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Stripe Connect — for CNA payouts (Express accounts)
STRIPE_CONNECT_CLIENT_ID=ca_your_connect_client_id_here

# ---- App URL ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Mapbox (P0 — for /browse + service area drawing) -----------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# ---- Email (Resend — for transactional email) -------------------------------
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=hello@kindredmarketplace.com

# ---- SMS (Twilio — P1, for SMS 2FA + notifications) -------------------------
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# ---- Background Checks (Checkr — leaning) -----------------------------------
# Decide partner before filling — see Partnerships tab in build tracker
CHECKR_API_KEY=

# ---- ID Verification (Stripe Identity — bundled with Stripe) ----------------
# No separate key — uses STRIPE_SECRET_KEY above

# ---- Error tracking (Sentry — P1) -------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=

# ---- Database direct connection (Supabase migrations + local seed) ----------
# Format: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:your-password-here@db.your-ref.supabase.co:5432/postgres
